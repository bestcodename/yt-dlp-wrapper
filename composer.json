{
  "name": "bestcodename/yt-dlp-tools",
  "type": "project",
  "version": "0.10.0",
  "require": {
    "php": ">=8.2",
    "symfony/console": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
